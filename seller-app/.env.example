# ─────────────────────────────────────────────────────────────────────────────
# CropSetu Seller App — Environment Variables (template)
# ─────────────────────────────────────────────────────────────────────────────
# React Native apps don't use a runtime .env by default — Expo bakes these
# into the JS bundle at build time via the `EXPO_PUBLIC_*` prefix.
# Anything in the compiled APK is extractable — never put real secrets here.
# For CI / EAS Build, set these under "EAS Secrets" in the Expo dashboard.
#
# Copy to .env and fill in. Both apps talk to the SAME backend, so these values
# normally match frontend/.env exactly.
# ─────────────────────────────────────────────────────────────────────────────

# Public API endpoint (overrides the __DEV__ default in ../shared/constants/config.js).
# Dev:  http://10.0.2.2:3001/api/v1         (Android emulator)
#       http://<LAN-IP>:3001/api/v1         (physical device / Expo Go)
# Prod: https://<your-railway-domain>/api/v1
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SOCKET_URL=
