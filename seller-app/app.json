{
  "expo": {
    "name": "KrushiSarva Seller",
    "slug": "cropsetu-seller",
    "scheme": "krushisarva-seller",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cropsetu.seller",
      "infoPlist": {
        "NSCameraUsageDescription": "KrushiSarva Seller needs camera access to photograph the products you list.",
        "NSPhotoLibraryUsageDescription": "KrushiSarva Seller needs photo library access to upload product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "package": "com.cropsetu.seller",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "KrushiSarva Seller needs photo library access to upload product images.",
          "cameraPermission": "KrushiSarva Seller needs camera access to photograph the products you list."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "7c72a202-c267-49e2-9c73-4f0e613b1da3"
      }
    },
    "owner": "shubhamyeljale2025"
  }
}
