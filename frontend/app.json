{
  "expo": {
    "name": "KrushiSarva",
    "slug": "cropsetu",
    "scheme": "krushisarva",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cropsetu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "KrushiSarva needs camera access to photograph your crops for AI disease analysis.",
        "NSPhotoLibraryUsageDescription": "KrushiSarva needs photo library access to upload crop images for analysis.",
        "NSLocationWhenInUseUsageDescription": "KrushiSarva uses your location to show local weather conditions for your farm.",
        "NSMicrophoneUsageDescription": "KrushiSarva uses your microphone for voice chat with the AI assistant."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#005f21"
      },
      "package": "com.cropsetu.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "KrushiSarva needs camera access to photograph your crops for AI disease analysis."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KrushiSarva uses your location to show local weather conditions for your farm."
        }
      ],
      "expo-secure-store",
      "react-native-compressor",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#005f21"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#005f21",
          "dark": {
            "backgroundColor": "#06210d"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f1df1b28-f453-4395-8134-e389cadb394a"
      }
    },
    "owner": "shubhamyeljale2025",
    "primaryColor": "#005f21"
  }
}
