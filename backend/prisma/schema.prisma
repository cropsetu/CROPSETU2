  notes     String?
  photos    String[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  predictions FarmerPrediction[]

  @@index([cropName])
  @@index([farmId, season, year])
  @@index([farmerId, status])
  @@index([sowingDate(sort: Desc)])
  @@map("farm_crop_cycles")
}

