// ── Audit Log — forensic trail for PII changes, order mutations, auth events ──
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // PII_UPDATE, ORDER_STATUS_CHANGE, ORDER_CANCEL, PRODUCT_DELETE, AUTH_LOGIN, etc.
  entity    String // User, Order, Product, Auth
  entityId  String
  before    String? // JSON stringified old values (PII redacted)
  after     String? // JSON stringified new values (PII redacted)
  ip        String?
  requestId String?
  metadata  String? // JSON extra context
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  // Login-risk lookback (runs every login on a high-volume table):
  // where userId + action + createdAt >= since, ORDER BY createdAt DESC.
  @@index([userId, action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ── Content moderation queue — fake-review / fake-listing signals (FRAUD-5) ──
// Suspicious reviews/listings (burst, duplication, new-account heuristics) are
// routed here for human moderation (REV-5 admin queue) rather than auto-removed.
// One flag row per content item; re-assessment upserts the reasons/score.
model ContentFlag {
  id           String           @id @default(uuid())
  entityType   String // 'Review' | 'Product'
  entityId     String
  authorId     String? // user/seller who created the content
  reasons      String[] // ['burst','duplicate','new_account']
  score        Int              @default(0)
  status       ModerationStatus @default(PENDING)
  metadata     String? // JSON extra context
  reviewedById String?
  reviewedAt   DateTime?
  resolution   String? // moderator note on resolve
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([entityType, entityId]) // one flag per item; re-assessment upserts
  @@index([status, createdAt]) // moderation queue: pending, newest first
  @@map("content_flags")
}

// ── Device ↔ account links — multi-account detection (FRAUD-3) ────────────────
// One row per (device, account) pair, observed at login/order. A single device
// fingerprint backing many DISTINCT accounts is the multi-account signal that
// surfaces to review. `fingerprint` is a hashed STRONG device id (the client's
// X-Device-Id) — NOT the coarse User-Agent fingerprint used for velocity
// bucketing, since thousands of users share a UA and would link spuriously.
// Rows age out by lastSeenAt so dormant links don't keep an actor "linked".
model DeviceAccountLink {
  id          String   @id @default(uuid())
  fingerprint String
  userId      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  seenCount   Int      @default(1)
  lastIp      String?
  lastContext String? // 'login' | 'order' — where the device was last observed
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fingerprint, userId])
  @@index([fingerprint, lastSeenAt]) // count distinct accounts per device in a window
  @@index([userId])
  @@map("device_account_links")
}

// ── Consent records — DPDP Act §5 lawful-basis proof ─────────────────────────
// Append-only: every grant or withdrawal is a new immutable row. The EFFECTIVE
// consent for a (user, purpose) is the most recent row by createdAt. Each row
// captures the policy version shown, the timestamp, and proof of the request
// (IP + user-agent + how it was captured) so consent can be demonstrated later.
model ConsentRecord {
  id            String         @id @default(uuid())
  userId        String
  purpose       ConsentPurpose
  granted       Boolean // true = granted, false = withdrawn
  policyVersion String // version of the terms/privacy notice presented (e.g. "2026-06-01")
  method        String? // how it was captured: "signup", "settings_toggle", "api"
  ip            String? // proof: request IP at the time of action
  userAgent     String? // proof: client user-agent at the time of action
  metadata      String? // JSON: any extra context (e.g. screen, locale)
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purpose])
  @@index([purpose])
  @@index([createdAt])
  @@map("consent_records")
}

// ── Security incident log — breach-notification tracking (DPDP §8(6)) ─────────
// One row per detected/reported incident. The notification fields record the
// statutory duty to inform the Data Protection Board of India and the affected
// data principals. Each incident has an append-only IncidentUpdate timeline.
model SecurityIncident {
  id                   String           @id @default(uuid())
  title                String
  description          String?
  category             IncidentCategory
  severity             IncidentSeverity
  status               IncidentStatus   @default(OPEN)
  source               String? // 'system' (auto-detected) | 'manual' | subsystem name
  detectedAt           DateTime         @default(now())
  reportedById         String? // user/admin who reported (null = system-detected)
  affectedUserCount    Int?
  affectedUserIds      String[] // ids of affected data principals (may be empty)
  dataCategories       String[] // PII categories involved, e.g. ['phone','aadhaar','bank']
  // ── Breach-notification duty tracking ──────────────────────────────────────
  notificationRequired Boolean          @default(false)
  notifyDueAt          DateTime? // SLA deadline to notify once required
  boardNotifiedAt      DateTime? // when the Data Protection Board was informed
  usersNotifiedAt      DateTime? // when affected users were informed
  rootCause            String?
  remediation          String?
  metadata             String? // JSON: extra structured context
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  updates              IncidentUpdate[]

  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([detectedAt])
  @@index([notificationRequired, boardNotifiedAt])
  @@map("security_incidents")
}

// Append-only timeline for an incident: notes + status transitions, who & when.
model IncidentUpdate {
  id         String           @id @default(uuid())
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String? // admin who added the note (null = system)
  note       String
  statusFrom IncidentStatus?
  statusTo   IncidentStatus?
  createdAt  DateTime         @default(now())

  @@index([incidentId])
  @@index([createdAt])
  @@map("incident_updates")
}

// ── Seller settlement ledger & payouts (admin WI-4, scope FINANCE) ────────────
// Append-only money ledger per seller plus the payout records computed from it.
// `sellerId` is a User id (a seller's account) kept as a scalar — no FK relation
// is added back onto User so this block stays purely ADDITIVE (zero edits to the
// existing User model / no migrate reset; applied with `prisma db push`).

// One immutable accounting entry against a seller's balance. SALE adds, the rest
// (COMMISSION, REFUND, PAYOUT) subtract; ADJUSTMENT is a signed manual correction.
// `balanceAfter` snapshots the running net balance at write time for auditability.
model SellerLedgerEntry {
  id           String          @id @default(uuid())
  sellerId     String // User id of the seller this entry belongs to
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(12, 2) // signed: positive credits the seller, negative debits
  orderId      String? // source order when the entry derives from a sale/refund
  balanceAfter Decimal         @db.Decimal(12, 2) // running net balance immediately after this entry
  note         String?
  createdBy    String? // admin User id for manual entries (null = system-generated)
  createdAt    DateTime        @default(now())

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([type])
  @@map("seller_ledger_entries")
}

enum LedgerEntryType {
  SALE
  COMMISSION
  REFUND
  PAYOUT
  ADJUSTMENT
}

// A payout to a seller for a settlement period. Created PENDING with a matching
// PAYOUT ledger entry; an admin then transitions it to PAID/FAILED with a method
// + reference. `sellerId` is a User id (scalar, no relation — additive).
model Payout {
  id          String       @id @default(uuid())
  sellerId    String // User id of the seller being paid
  amount      Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(PENDING)
  method      String? // e.g. 'bank_transfer', 'upi'
  reference   String? // bank/UTR reference or failure note
  periodFrom  DateTime // settlement window start (inclusive)
  periodTo    DateTime // settlement window end (inclusive)
  processedBy String? // admin User id who created / last transitioned the payout
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  /// Nothing stopped two payouts being raised for the same seller and the same
  /// settlement window — i.e. paying a seller twice. The window is the natural
  /// key, so the DB enforces it rather than the admin UI hoping nobody
  /// double-clicks.
  @@unique([sellerId, periodFrom, periodTo])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// ── Dispute resolution (WI-6) — Animal Trade / Rent booking / Order disputes ──
// A dispute is a support/moderation case opened against a transaction. `refId`
// points at the underlying record by `type` (a Chat/AnimalListing for ANIMAL_TRADE,
// a Booking for RENT_BOOKING, an Order for ORDER) — kept as a loose scalar (NOT a
// hard FK) so a dispute survives the deletion of the thing it references and so
// one model spans three heterogeneous targets. Linked context is resolved on read
// (with PII masked). Created/triaged by admins/support; see disputes.routes.js.
model Dispute {
  id          String        @id @default(uuid())
  type        DisputeType
  refId       String // id of the Chat/AnimalListing (ANIMAL_TRADE) | Booking (RENT_BOOKING) | Order (ORDER)
  raisedBy    String // user id who raised it
  againstUser String? // user id the dispute is against (optional)
  reason      String
  status      DisputeStatus @default(OPEN)
  resolution  String? // moderator resolution note (set on RESOLVED/CLOSED)
  assignedTo  String? // admin user id the case is assigned to
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("disputes")
}

enum DisputeType {
  ANIMAL_TRADE
  RENT_BOOKING
  ORDER
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

// Reusable, multilingual push-notification template. titleI18n/bodyI18n hold the
// 9 supported languages (en + hi/mr/ta/kn/ml/te/bn/gu/pa) as JSON maps keyed by
// language code; a broadcast may resolve its title/body from a template by `key`.
// Soft-deleted via isActive=false so a template referenced by historical sends
// stays resolvable in the audit/history trail.
model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  titleI18n Json
  bodyI18n  Json
  category  String   @default("general")
  isActive  Boolean  @default(true)
  createdBy String? // admin who created the template (null = system/seed)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@map("notification_templates")
}

// One row per admin broadcast send — the delivery/broadcast history with real
// estimated/sent/failed counts. `filters` records the audience target, and
// `templateKey` links back to the NotificationTemplate when the send was composed
// from one. Append-only; surfaced by GET /admin/notifications/history.
model BroadcastLog {
  id          String   @id @default(uuid())
  sentBy      String? // admin who sent the broadcast (null = system)
  filters     Json
  title       String
  body        String
  templateKey String?
  estimated   Int      @default(0)
  sent        Int      @default(0)
  failed      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([sentBy])
  @@index([templateKey])
  @@index([createdAt])
  @@map("broadcast_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SHOP HARDENING — payments, agri-chemical compliance, batches, recalls, blocks
// ═══════════════════════════════════════════════════════════════════════════════

/// One attempt to take money, recorded BEFORE the gateway is called.
///
/// The flow used to be: POST /orders/initiate created a Razorpay order and wrote
/// NOTHING locally, then POST /orders/confirm created the Order. If the app died
/// between the two — the exact thing that happens on a village connection — the
/// farmer's money was captured and no record of it existed anywhere in this
/// system. Nothing could reconcile it because nothing knew the payment had been
/// started. This row is that knowledge, and it is also where the authoritative
/// quote is frozen so `confirm` charges what `initiate` priced.
model PaymentIntent {
  id              String   @id @default(uuid())
  userId          String
  provider        String   @default("razorpay")
  /// Gateway order id (Razorpay `order_...`). Unique so a webhook and a client
  /// confirm converge on the same row instead of racing to create two.
  providerOrderId String   @unique
  /// Gateway payment id, once one exists. Unique for the same reason Order.paymentRef is.
  providerPaymentId String? @unique
  amount          Decimal  @db.Decimal(12, 2)
  amountPaise     Int
  currency        String   @default("INR")
  receipt         String
  status          PaymentIntentStatus @default(CREATED)
  /// The frozen quote (subtotal / delivery / tax / per-shipment lines) this
  /// payment was raised for. `confirm` rebuilds the quote and refuses if the
  /// payable moved, so the buyer is never charged a stale amount.
  quoteSnapshot   Json?
  /// Cart fingerprint at initiate time — listing ids + quantities + unit prices.
  /// A cart edited in another tab/device between initiate and confirm changes it.
  cartHash        String?
  orderId         String?  @unique
  failureReason   String?
  /// Set by the reconciler once the intent reached a terminal, explained state.
  reconciledAt    DateTime?
  reconcileNote   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  // The reconciler sweeps stale non-terminal intents.
  @@index([status, createdAt])
  @@map("payment_intents")
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  PAID
  ORDER_CREATED
  FAILED
  CANCELLED
  REFUND_INITIATED
  REFUNDED
  EXPIRED
}

/// Every gateway webhook, stored before it is acted on. `eventId` is unique, so
/// a redelivered webhook (Razorpay retries for 24h) is a no-op instead of a
/// second order or a second refund. Signature verification happens before insert.
model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("razorpay")
  eventId     String   @unique
  eventType   String
  providerOrderId   String?
  providerPaymentId String?
  status      String   @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  error       String?
  /// Raw payload is deliberately NOT stored — it carries buyer contact details
  /// and card metadata. Only the fields the handler needs are extracted above.
  payloadDigest String?
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@index([providerOrderId])
  @@map("payment_webhook_events")
}

/// A seller's regulatory licence to sell a class of regulated input.
///
/// SellerProfile already carries ONE Kendra licence (number/type/state/expiry)
/// used for Kendra discovery. That is a single flat set of columns and cannot
/// express "this seller may sell fertilizer but is not licensed for insecticides",
/// which is precisely the distinction the sale gate needs. This is one row per
/// (seller, licence class), verified independently, with its own expiry.
model SellerLicence {
  id               String   @id @default(uuid())
  sellerId         String
  /// Licence class, matched against ProductCompliance.regulatedKind.
  kind             RegulatedKind
  licenceNumber    String
  issuingAuthority String?
  state            String?
  district         String?
  validFrom        DateTime?
  validTo          DateTime?
  /// PRIVATE Cloudinary public_ids, exactly like KYC docs — served only through
  /// short-lived signed URLs, never returned to buyers.
  documentIds      String[] @default([])
  status           LicenceStatus @default(PENDING)
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seller User @relation("SellerLicences", fields: [sellerId], references: [id], onDelete: Cascade)

  /// One live licence per class per seller; a renewal updates the row.
  @@unique([sellerId, kind])
  // The sale gate asks "is this seller APPROVED for this kind, right now".
  @@index([sellerId, kind, status])
  // The expiry sweeper scans licences falling due.
  @@index([status, validTo])
  @@map("seller_licences")
}

enum RegulatedKind {
  NONE
  SEED
  FERTILIZER
  BIO_PRODUCT
  PESTICIDE
  INSECTICIDE
  FUNGICIDE
  HERBICIDE
  PLANT_GROWTH_REGULATOR
}

enum LicenceStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
}

/// The regulated-product record: what the approved label says, and whether an
/// administrator has signed it off. A regulated product stays UNPUBLISHED until
/// this row is APPROVED.
///
/// Every text field here is TRANSCRIBED FROM THE APPROVED MANUFACTURER LABEL by
/// the seller and checked by a reviewer. Nothing in this system generates dosage,
/// mixing, crop, pest or first-aid text — see services/shopCompliance.service.js.
model ProductCompliance {
  id                  String   @id @default(uuid())
  productId           String   @unique
  regulatedKind       RegulatedKind @default(NONE)
  /// CIB&RC (or equivalent) registration for the formulation.
  registrationNumber  String?
  registrationAuthority String?
  registrationValidTo DateTime?
  activeIngredient    String?
  formulation         String?   // EC, SC, WP, WG, SL …
  concentration       String?   // "50% EC"
  /// Label-approved crops and target pests. Arrays of plain strings copied from
  /// the label; the app renders them as-is and never extrapolates to a crop that
  /// is not on the list.
  approvedCrops       String[] @default([])
  targetPests         String[] @default([])
  /// Verbatim label sections. NULL means "the label section was not supplied",
  /// which the UI shows as such — it never substitutes generic advice.
  dosageText          String?
  safetyEquipment     String[] @default([])
  storageInstructions String?
  firstAidText        String?
  precautionText      String?
  /// Scan / PDF of the approved label, and the label revision it corresponds to.
  /// The revision is snapshotted onto each order item.
  labelDocId          String?
  labelVersion        String?
  /// Whether listings of this product must carry a batch number / expiry date.
  requiresBatch       Boolean  @default(true)
  requiresExpiry      Boolean  @default(true)
  /// Minimum shelf life (days) that must remain at DISPATCH. A farmer buying a
  /// fungicide that expires next week has effectively bought nothing.
  minShelfLifeDays    Int      @default(30)
  status              ComplianceStatus @default(DRAFT)
  reviewedBy          String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([regulatedKind, status])
  @@index([registrationValidTo])
  @@map("product_compliance")
}

enum ComplianceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

/// Batch-level stock for regulated inputs. One row per physical lot a seller
/// holds of one offer.
///
/// SellerListing.stockQty stays the authoritative sellable number (checkout's
/// Serializable decrement is on it and must not be split across two counters);
/// batches record WHICH lots make it up, so an expiry or a recall can remove the
/// affected quantity and a shipped item can name its lot.
model ProductBatch {
  id            String   @id @default(uuid())
  listingId     String
  sellerId      String
  batchNumber   String
  manufactureDate DateTime?
  expiryDate    DateTime?
  /// Units of this lot the seller still holds. Reduced on dispatch, zeroed when
  /// the lot is quarantined or recalled.
  quantity      Int      @default(0)
  status        BatchStatus @default(ACTIVE)
  quarantineReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing SellerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, batchNumber])
  // Pick the batch to dispatch: earliest expiry first, among live lots.
  @@index([listingId, status, expiryDate])
  // The expiry sweeper and the "expiring soon" admin alert.
  @@index([status, expiryDate])
  @@index([sellerId])
  @@map("product_batches")
}

enum BatchStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  RECALLED
  QUARANTINED
  DAMAGED
}

/// A recall. Scoped to a product, and optionally narrowed to one batch and/or
/// one seller. Creating one blocks further sale immediately and produces the
/// list of affected buyers to notify.
model ProductRecall {
  id           String   @id @default(uuid())
  productId    String
  batchNumber  String?
  sellerId     String?
  reason       String
  severity     String   @default("HIGH") // HIGH | MEDIUM | LOW
  advice       String?  // verbatim manufacturer / authority instruction to buyers
  initiatedBy  String?
  notifiedCount Int     @default(0)
  notifiedAt   DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
  @@index([batchNumber])
  @@index([isActive, createdAt])
  @@map("product_recalls")
}

/// Administrative sale block. One table for every axis an operator needs to stop
/// a sale on — product, seller, batch, state, district — because a regulator's
/// restriction ("this insecticide may not be sold in Maharashtra") arrives as a
/// geography, not as a list of listing ids.
///
/// Evaluated by services/shopCompliance.service.js on every add-to-cart and every
/// checkout line. Cached in Redis; the cache is bumped on write.
model SaleBlock {
  id         String   @id @default(uuid())
  scope      SaleBlockScope
  productId  String?
  sellerId   String?
  categoryId String?
  batchNumber String?
  state      String?
  district   String?
  reason     String
  /// Shown to the buyer. Kept separate from `reason` (which is internal) so an
  /// enforcement note never leaks into the app.
  publicMessage String?
  isActive   Boolean  @default(true)
  createdBy  String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, scope])
  @@index([isActive, productId])
  @@index([isActive, sellerId])
  @@index([isActive, state])
  @@index([isActive, district])
  @@map("sale_blocks")
}

enum SaleBlockScope {
  PRODUCT
  SELLER
  CATEGORY
  BATCH
  STATE
  DISTRICT
}

/// PIN-code serviceability. Which pincodes a seller ships to, the promised
/// transit time, and any surcharge.
///
/// Serviceability was previously inferred from `sellScope` + a district string
/// compared case-insensitively, which cannot answer "will this reach 413102 and
/// by when" — the only question the buyer actually asks. A seller with no rows
/// here keeps the old sellScope behaviour, so this is additive.
model SellerServiceArea {
  id           String   @id @default(uuid())
  sellerId     String
  /// Either an exact 6-digit pincode, or a 3-digit prefix covering a sorting
  /// region ("413" = Solapur). Prefix rows let a seller cover a district without
  /// enumerating 400 pincodes.
  pincode      String?
  pincodePrefix String?
  state        String?
  district     String?
  /// Deterministic, NON-NULL identity for the area this row covers:
  /// `pin:413102` | `pre:413` | `dist:pune` | `state:maharashtra`.
  ///
  /// It exists because the obvious constraint — @@unique([sellerId, pincode,
  /// pincodePrefix]) — does NOT work, for two independent reasons:
  ///   1. Postgres treats NULLs as DISTINCT in a unique index, and every real
  ///      row has a NULL in at least one of those columns (a row covers either
  ///      an exact pincode or a prefix, never both). So the constraint silently
  ///      permitted unlimited duplicates.
  ///   2. Prisma rejects `null` inside a compound-unique WHERE input, so the
  ///      upsert that maintains these rows could not even be expressed.
  /// One non-null key fixes both.
  matchKey     String
  etaMinDays   Int      @default(2)
  etaMaxDays   Int      @default(5)
  surcharge    Decimal  @default(0) @db.Decimal(10, 2)
  codAvailable Boolean  @default(true)
  pickupAvailable Boolean @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller User @relation("SellerServiceAreas", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, matchKey])
  // The serviceability probe: exact pincode first, then prefix.
  @@index([pincode, isActive])
  @@index([pincodePrefix, isActive])
  @@index([sellerId, isActive])
  @@map("seller_service_areas")
}

/// Units held for one buyer while their payment is in flight.
///
/// ── The race this closes ─────────────────────────────────────────────────────
/// Stock was decremented only when the order was created, i.e. at /orders/confirm,
/// AFTER the money had moved. So two buyers could both open the payment sheet for
/// the last bag of seed, both pay, and the second one would be told "insufficient
/// stock" having already been charged. The platform then owed a refund for a
/// checkout it had allowed to happen.
///
/// ── How it works ─────────────────────────────────────────────────────────────
/// /orders/initiate decrements `seller_listings.stockQty` and writes one HELD row
/// per line. /orders/confirm then creates the order WITHOUT decrementing again and
/// flips the rows to CONSUMED. Abandonment, failure and expiry all RELEASE — which
/// increments the stock back.
///
/// The decisive property: `stockQty` keeps meaning exactly what it meant before —
/// "units available to sell right now". Every read path (buy box, product list,
/// cart validation, the storefront filter) is therefore unchanged. The alternative
/// — leaving stock alone and subtracting live reservations at read time — would
/// have required every one of those paths to learn about reservations, and any one
/// that forgot would oversell.
model StockReservation {
  id        String   @id @default(uuid())
  listingId String
  userId    String
  quantity  Int
  /// The payment this reservation is being held for. Nullable so a reservation
  /// can be written before the intent row exists in the same transaction.
  paymentIntentId String?
  /// The gateway order id, which is what /confirm arrives holding.
  providerOrderId String?
  status    ReservationStatus @default(HELD)
  expiresAt DateTime
  releasedAt DateTime?
  releaseReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing SellerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // The confirm path: "what is being held for this gateway order".
  @@index([providerOrderId, status])
  // The sweeper: expired holds, oldest first.
  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([listingId, status])
  @@map("stock_reservations")
}

enum ReservationStatus {
  HELD
  CONSUMED
  RELEASED
  EXPIRED
}
