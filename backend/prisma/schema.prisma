generator client {
  provider        = "prisma-client-js"
  // postgresqlExtensions: lets the schema declare pg_trgm so trigram GIN indexes
  // (which accelerate ILIKE '%term%' substring search) are managed by Prisma and
  // not dropped by `prisma db push`.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id                       String               @id @default(uuid())
  phone                    String               @unique
  // Optional contact email. Nullable + unique — Postgres allows many NULLs, so
  // farmers who never add one don't collide. Stored lowercased/trimmed.
  email                    String?              @unique
  name                     String?
  avatar                   String?
  statusQuote              String?
  role                     Role                 @default(FARMER)
  // Admin RBAC sub-role scopes. An ADMIN with an EMPTY array = SUPER_ADMIN, so
  // existing admins keep full access until scopes are deliberately assigned.
  adminScopes              String[]             @default([])
  language                 String               @default("en")
  /// Farmer-controlled mute for ACTIVITY pushes (order/booking/reply/like).
  /// Security alerts — new-device login, location anomaly, OTP — IGNORE this
  /// flag: a stolen handset must not be able to silence the warning that it was
  /// stolen. See services/push.service.js.
  notificationsEnabled     Boolean              @default(true)
  isActive                 Boolean              @default(true)
  // Bumped on security-sensitive changes (e.g. phone change). Access tokens
  // embed the version at issue time; a stale version is rejected at auth.
  tokenVersion             Int                  @default(0)
  pincode                  String?
  district                 String?
  city                     String?
  state                    String?              @default("Maharashtra")
  // Encrypted at rest (AES-256-GCM ciphertext string). Decrypt to a Float in
  // app code before any geo math — see utils/encrypt.js + cropReportShare routes.
  lat                      String?
  lng                      String?
  isOnline                 Boolean              @default(false)
  lastSeenAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  businessType             String?
  gstNumber                String?
  gstOptOut                Boolean              @default(false)
  kycStatus                KycStatus            @default(PENDING)
  profileCompletion        Int                  @default(0)
  taluka                   String?
  village                  String?
  aadhaarLast4             String?
  activeFarmId             String?
  // Encrypted at rest (AES-256-GCM ciphertext string). Decrypt to a number on read.
  annualHouseholdIncome    String?
  dateOfBirth              DateTime?
  // ── DPDP Act §9 (children's data) ──────────────────────────────────────────
  // isMinor is derived from dateOfBirth (< 18) and persisted so it can gate
  // restricted flows without recomputing. guardianConsentAt records verifiable
  // parental/guardian consent (the lawful basis to process a child's data).
  isMinor                  Boolean              @default(false)
  guardianConsentAt        DateTime?
  dependents               Int?
  education                Education?
  familySize               Int?
  farmingExperienceYrs     Int?
  gender                   Gender?
  hasKisanCreditCard       Boolean              @default(false)
  hasPmKisanAccount        Boolean              @default(false)
  hasSoilHealthCard        Boolean              @default(false)
  lastActiveAt             DateTime?
  onboardingStep           OnboardingStep       @default(BASIC)
  preferredContactMethod   String?
  preferredMandi           String?
  totalFarms               Int                  @default(0)
  totalLandAcres           Float                @default(0)
  aiConversations          AIConversation[]
  aiCredits                AICredit?
  aiUsage                  AIUsage[]
  animalListings           AnimalListing[]
  bookings                 Booking[]
  cartItems                CartItem[]
  chatsAsBuyer             Chat[]               @relation("BuyerChats")
  chatsAsSeller            Chat[]               @relation("SellerChats")
  commentLikes             CommentLike[]
  comments                 Comment[]
  consentRecords           ConsentRecord[]
  cropCalendars            CropCalendar[]
  cropDiseaseReports       CropDiseaseReport[]
  cropReportSharesAsFarmer CropReportShare[]    @relation("CropReportSharesByFarmer")
  cropReportSharesAsSeller CropReportShare[]    @relation("CropReportSharesToSeller")
  dmsReceived              DirectMessage[]      @relation("DMsReceived")
  dmsSent                  DirectMessage[]      @relation("DMsSent")
  diseaseFeedbacks         DiseaseFeedback[]
  farmCropCycles           FarmCropCycle[]
  farmDetail               FarmDetail?
  farmSoilReports          FarmSoilReport[]
  farmWeatherHistories     FarmWeatherHistory[]
  farmerPredictions        FarmerPrediction[]
  farms                    Farm[]               @relation("FarmerFarms")
  groupMembers             GroupMember[]
  groupMessages            GroupMessage[]       @relation("GroupMessagesSent")
  groupsCreated            Group[]              @relation("GroupsCreated")
  irrigationLogs           IrrigationLog[]
  labourListings           LabourListing[]
  machineryListings        MachineryListing[]
  notifications            Notification[]
  orders                   Order[]
  otpSessions              OtpSession[]
  plannerTasks             PlannerTask[]
  postBookmarks            PostBookmark[]
  postLikes                PostLike[]
  posts                    Post[]
  priceAlerts              PriceAlert[]
  sellerProducts           Product[]            @relation("SellerProducts")
  sellerListings           SellerListing[]      @relation("SellerListings")
  sellerLicences           SellerLicence[]      @relation("SellerLicences")
  sellerServiceAreas       SellerServiceArea[]  @relation("SellerServiceAreas")
  pushTokens               PushToken[]
  refreshTokens            RefreshToken[]
  reviews                  Review[]
  savedAddresses           SavedAddress[]
  schemeApplications       SchemeApplication[]
  sellerProfile            SellerProfile?
  soilHealthRecords        SoilHealthRecord[]
  activeFarm               Farm?                @relation("ActiveFarm", fields: [activeFarmId], references: [id], onDelete: SetNull)
  voiceSessions            VoiceSession[]
  voiceConversations       VoiceConversation[]
  deviceLinks              DeviceAccountLink[]
  listingReportsFiled      ListingReport[]      @relation("ListingReportsFiled")
  blocksMade               UserBlock[]          @relation("BlocksMade")
  blocksReceived           UserBlock[]          @relation("BlocksReceived")

  @@index([phone])
  @@index([district])
  @@index([kycStatus])
  @@index([activeFarmId])
  @@index([lastActiveAt(sort: Desc)])
  @@map("users")
}

model SellerProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  bankHolderName    String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  aadharNumber      String?
  panNumber         String?
  kycDocumentUrls   String[]
  kycVerifiedAt     DateTime?
  kycRejectedReason String?
  // ── Krushi Seva Kendra agri-input dealer licence ─────────────────────────────
  // A Kendra registers with its agri-input dealer licence; an admin verifies the
  // licence + documents (User.kycStatus → VERIFIED) BEFORE the Kendra is approved
  // and becomes discoverable to nearby farmers (see cropReportShare routes — only
  // VERIFIED Kendras surface). Number/type/state/expiry are business-registration
  // data (not personal PII) so stored plaintext; the licence document scans go to
  // PRIVATE Cloudinary storage (public_ids only) exactly like KYC docs and are
  // served via short-lived signed URLs. licenceVerifiedAt is stamped on approval.
  licenceNumber       String?
  licenceType         String?
  licenceIssuingState String?
  licenceExpiry       DateTime?
  licenceDocUrls      String[]  @default([])
  licenceVerifiedAt   DateTime?
  // ── Fulfillment metrics (CATALOG-SPLIT) ─────────────────────────────────────
  // DERIVED AGGREGATES, never computed per request. sellerMetrics.service.js
  // refreshes them from order_items / reviews / return_requests on a schedule and
  // stamps metricsUpdatedAt. The buy box reads them; while metricsUpdatedAt is
  // NULL the seller has no history yet, so the buy box substitutes a neutral
  // rating and zeroes the fulfillment weight rather than ranking on noise.
  rating              Float     @default(0)
  ratingCount         Int       @default(0)
  cancellationRate    Float     @default(0)   // cancelled items / terminal items
  onTimeDispatchRate  Float     @default(1)   // shipped within dispatchSlaDays
  returnRate          Float     @default(0)   // returned items / delivered items
  metricsUpdatedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([metricsUpdatedAt])
  @@map("seller_profiles")
}

model FarmDetail {
  id             String   @id @default(uuid())
  userId         String   @unique
  village        String?
  district       String?
  state          String?
  pincode        String?
  landAcres      Float?
  cropTypes      String[]
  soilType       String?
  irrigationType String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("farm_details")
}

model OtpSession {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_sessions")
}

model RefreshToken {
  id               String    @id @default(uuid())
  token            String    @unique
  userId           String
  // Rotation lineage: every token minted by rotating a predecessor shares its
  // familyId. Detecting reuse of a rotated token lets us revoke the whole family.
  familyId         String?
  // Set when this token is rotated (used to mint a successor). A non-null value
  // means the token is spent — presenting it again is reuse.
  rotatedAt        DateTime?
  // When the SESSION (lineage) began — preserved across rotations so the server
  // can enforce an absolute session timeout regardless of refresh activity.
  sessionStartedAt DateTime?
  // Idle timeout: a token is only valid until expiresAt; each rotation slides it
  // forward, so a session that goes idle past the window can no longer refresh.
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  platform  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  nameHi    String?
  nameMr    String?
  nameTa    String?
  nameKn    String?
  nameMl    String?
  nameTe    String?
  nameBn    String?
  nameGu    String?
  namePa    String?
  icon      String?
  color     String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  /// Which dynamic attribute schema the seller form and the buyer's detail page
  /// render for products in this category (see constants/productAttributes.js).
  /// NULL = the generic schema. Editable from admin, so a new category does not
  /// need an app release to get the right form.
  attributeSchema String?
  /// Products in this category are agricultural chemicals / regulated inputs and
  /// go through the compliance gate before they can be published. A CATEGORY flag
  /// rather than a hard-coded name list, because category names are admin-editable.
  isRegulated Boolean @default(false)
  products  Product[]
  subcategories Subcategory[]

  @@map("categories")
}

/// Backend-managed subcategory master data.
///
/// `products.subcategory` was a free-text string typed by whichever seller
/// created the row, so "Vegetable Seeds", "vegetable seeds" and "Veg Seeds" were
/// three different filter values and an admin could neither rename nor reorder
/// nor retire any of them. The string column is RETAINED and dual-written (same
/// EXPAND pattern as the catalog split) so existing filters keep working.
model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  nameHi     String?
  nameMr     String?
  icon       String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  /// Overrides the parent category's schema when a subcategory needs its own form
  /// (e.g. "Sprayers" inside "Farm Machinery").
  attributeSchema String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, name])
  @@index([categoryId, isActive, sortOrder])
  @@map("subcategories")
}

/// CATALOG identity — one row per real-world product, shared by every seller.
///
/// EXPAND PHASE (CATALOG-SPLIT step 1): the offer columns below (price, mrp,
/// stock, unit, minOrderQty, sellScope, district/taluka/village/state,
/// harvestDate, sellerId, isActive, isFeatured) are RETAINED and dual-written so
/// the pre-split read paths keep working while the new tables fill up. They are
/// dropped in the CONTRACT phase — see prisma/manual/catalog_split_3_contract.sql.
/// `price` was NOT NULL and is now nullable: a catalog-only row (admin-created,
/// or created by a seller through the new attach flow) has no price of its own.
/// Do NOT add new reads of these columns; read seller_listings instead.
model Product {
  id              String      @id @default(uuid())
  categoryId      String
  sellerId        String?     /// DEPRECATED (offer) — moved to seller_listings.sellerId
  name            String
  nameHi          String?
  nameMr          String?
  description     String?
  price           Decimal?    @db.Decimal(12, 2) /// DEPRECATED (offer) — seller_listings.sellingPrice
  mrp             Decimal?    @db.Decimal(12, 2) /// DEPRECATED (offer)
  unit            String      @default("kg")     /// DEPRECATED — moved to product_variants.unit
  stock           Int         @default(0)        /// DEPRECATED (offer) — seller_listings.stockQty
  images          String[]
  tags            String[]
  rating          Float       @default(0)
  ratingCount     Int         @default(0)
  isActive        Boolean     @default(true)     /// DEPRECATED — superseded by `status`
  isFeatured      Boolean     @default(false)    /// DEPRECATED (offer)
  district        String?     /// DEPRECATED (offer)
  state           String?     /// DEPRECATED (offer)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  brand           String?
  countryOfOrigin String?
  harvestDate     String?     /// DEPRECATED (offer)
  highlights      String[]
  manufacturer    String?
  minOrderQty     Int         @default(1)        /// DEPRECATED (offer)
  sellScope       String      @default("district") /// DEPRECATED (offer)
  specifications  Json?
  subcategory     String?
  taluka          String?     /// DEPRECATED (offer)
  viewCount       Int         @default(0)
  village         String?     /// DEPRECATED (offer)

  // ── Catalog identity (CATALOG-SPLIT) ────────────────────────────────────────
  /// Manufacturer's model / pack code. Second dedup gate after GTIN
  /// (`brand + modelNumber`). Most Indian agri-input SKUs have neither, which is
  /// why the primary gate is `normalizedKey`.
  modelNumber      String?
  /// QC lifecycle. Replaces the three-way overload of `isActive` (seller pause /
  /// seller soft-delete / admin toggle). Deliberately NOT ModerationStatus (that
  /// vocabulary is shared with ContentFlag's fraud queue) and NOT ListingStatus
  /// (that belongs to Animal/Machinery/Labour listings).
  status           ProductStatus @default(PENDING_QC)
  /// Who proposed this catalog entry. NULL for admin/seed-created rows.
  createdBySellerId String?
  /// Deterministic dedup key: normalizeProductKey(brand, manufacturer, name,
  /// categoryId). Defaulted to '' so `db push` can add the column to a populated
  /// table; the backfill computes real values. See services/catalogMatch.service.js.
  normalizedKey    String       @default("")
  /// Set when an admin merges this duplicate into a surviving catalog row.
  /// Reads of a MERGED product redirect here.
  mergedIntoId     String?
  qcReviewedBy     String?
  qcReviewedAt     DateTime?
  qcRejectionReason String?

  // ── Tax (SHOP-HARDENING) ───────────────────────────────────────────────────
  /// GST slab for this product, as a percentage. Agri-inputs are NOT one rate:
  /// most seeds are exempt, fertilizers are 5%, many pesticides 18%, machinery
  /// 12%. NULL falls back to the admin-set `shop.tax.defaultRatePct`. Tax is
  /// computed server-side from THIS column — never from anything the app sends.
  taxRatePct       Decimal?    @db.Decimal(5, 2)
  hsnCode          String?
  /// Shipping class. Machinery cannot ride the normal per-parcel delivery maths,
  /// so the quote charges it separately (or refuses to quote and asks for a
  /// freight quote). See services/shopPricing.service.js.
  shippingClass    String      @default("PARCEL")
  /// Shipping weight in kg and the longest dimension in cm, used by the freight
  /// band for HEAVY/FREIGHT classes. NULL = unknown, which falls back to the
  /// flat band rather than to zero.
  weightKg         Decimal?    @db.Decimal(10, 3)
  /// Master-data subcategory. `subcategory` (String) above is dual-written.
  subcategoryId    String?

  cartItems       CartItem[]
  orderItems      OrderItem[]
  category        Category    @relation(fields: [categoryId], references: [id])
  subcategoryRef  Subcategory? @relation(fields: [subcategoryId], references: [id])
  seller          User?       @relation("SellerProducts", fields: [sellerId], references: [id])
  reviews         Review[]
  variants        ProductVariant[]
  compliance      ProductCompliance?
  recalls         ProductRecall[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([district])
  @@index([taluka])
  @@index([isActive, isFeatured])
  @@index([isActive, rating])
  @@index([createdAt])
  // Seller's product list: where sellerId + ORDER BY createdAt DESC.
  @@index([sellerId, createdAt(sort: Desc)])
  // ── Post-split storefront plan ──────────────────────────────────────────────
  // [isActive, isFeatured] / [isActive, rating] span columns that end up on two
  // different tables after CONTRACT, so those composite plans are lost. The
  // storefront becomes: filter+sort seller_listings (its own composite indexes),
  // then hydrate products by id (PK). These replacements keep the catalog-side
  // half of every remaining predicate index-served.
  @@index([status, categoryId])
  @@index([status, rating])
  @@index([subcategoryId])
  // Storefront sorts. `createdAt DESC` (Latest) and `rating DESC` (Top rated) are
  // both keyset-paginated on (status, <sort>, id), so each needs the id tiebreaker
  // IN the index or the sort spills to a filesort on every page.
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, rating(sort: Desc), id(sort: Desc)])
  @@index([normalizedKey])
  @@index([brand, modelNumber])
  @@index([mergedIntoId])
  // Trigram GIN indexes accelerate the catalogue search (name/description
  // ILIKE '%term%'), which a btree cannot serve due to the leading wildcard.
  // NOTE: gin_trgm_ops supports % and ILIKE but NOT the <-> KNN operator (that
  // needs gist_trgm_ops), so catalogMatch materialises candidates with % first
  // and only then orders them by similarity() — never ORDER BY <-> against these.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm")
  // The search WHERE is an OR over name / description / tags. The trigram
  // migration's own warning applies: a single unindexed OR branch forces a full
  // scan of the whole clause, which was silently cancelling out both GIN indexes
  // above. `tags` is a String[], so it needs an array GIN to serve `has`.
  @@index([tags], type: Gin, map: "products_tags_gin")
  @@map("products")
}

/// The sellable unit. For agri-inputs the variant axis is PACK SIZE — "Mahyco Bt
/// Cotton Seed" is one catalog product with 450 g and 1 kg variants; three Krushi
/// Seva Kendras then attach one seller_listing each per variant.
model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  /// Variant axis, e.g. { "packSize": "450g" }. Free-form so a sprayer can use
  /// { "capacityL": 16 } without a schema change.
  attributes Json     @default("{}")
  unit       String   @default("kg")
  /// Retail barcode. Nullable-unique: Postgres allows many NULLs, and most Indian
  /// agri-input SKUs have no barcode at all — this is a dedup BACKSTOP, not the gate.
  gtin       String?  @unique
  sku        String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  listings  SellerListing[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

/// One seller's OFFER against one variant. This is what has a price, stock and
/// geography; the catalog row has none of that.
model SellerListing {
  id              String      @id @default(uuid())
  sellerId        String
  variantId       String
  sellingPrice    Decimal     @db.Decimal(12, 2)
  mrp             Decimal?    @db.Decimal(12, 2)
  stockQty        Int         @default(0)
  condition       String      @default("NEW")
  dispatchSlaDays Int         @default(2)
  sellerSku       String?
  minOrderQty     Int         @default(1)
  sellScope       String      @default("district")
  district        String?
  taluka          String?
  village         String?
  state           String?
  harvestDate     String?
  /// The seller's own photographs of their actual stock — deliberately separate
  /// from Product.images (the shared catalog imagery).
  images          String[]    @default([])
  status          ListingState @default(ACTIVE)
  isFeatured      Boolean     @default(false)
  rating          Float       @default(0)
  ratingCount     Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  seller    User           @relation("SellerListings", fields: [sellerId], references: [id])
  cartItems CartItem[]
  batches   ProductBatch[]
  reservations StockReservation[]

  /// One offer per seller per variant — a Kendra cannot list the same pack twice.
  @@unique([sellerId, variantId])
  // Buy-box candidate scan: all live offers for a variant, cheapest first.
  @@index([variantId, status, sellingPrice])
  // Seller's own offer list (mirrors the old [sellerId, createdAt] product index).
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([sellerId, status])
  // Geography eligibility gate.
  @@index([district])
  @@index([taluka])
  @@index([status, isFeatured])
  @@map("seller_listings")
}

/// EXPAND PHASE: `listingId` is the new key. `productId` stays NOT NULL and is
/// dual-written (derived from the listing's variant) so the pre-split read paths
/// keep working until CONTRACT drops the column.
///
/// `@@unique([userId, productId])` is GONE ALREADY, in EXPAND rather than CONTRACT.
/// It is the constraint that made it physically impossible for one buyer to hold
/// the same seed from two Kendras — the exact thing this project exists to allow —
/// so keeping it through the dual-write window would have meant the multi-seller
/// cart did not actually work until the very last step. (It doesn't: a second
/// offer of the same product 500s on P2002. Caught by the test that adds two
/// Kendras' offers of one seed to one cart.) Dropping a unique index destroys no
/// rows and is safe for `db push`; the plain index that replaces it still serves
/// the dual-read lookups.
model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  /// Which seller's offer this line is for. Nullable only during EXPAND (rows
  /// written before the backfill); the API refuses to create a NULL one.
  listingId String?
  /// Price snapshot at add-to-cart time. Checkout revalidates against the live
  /// listing and surfaces any difference to the buyer rather than silently
  /// re-pricing the line.
  unitPriceSnapshot Decimal? @db.Decimal(12, 2)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  listing   SellerListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([userId, productId])
  @@index([listingId])
  @@map("cart_items")
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("HOME")
  name      String
  phone     String
  flat      String
  street    String
  city      String
  state     String
  pincode   String
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("saved_addresses")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  status          OrderStatus @default(PENDING)
  /// THE PAYABLE. Before SHOP-HARDENING this was the goods subtotal and the app
  /// added a hard-coded ₹49 delivery fee on the client that the order never
  /// recorded — the farmer was shown one number and charged another. It is now
  /// subtotal + deliveryFee + taxAmount − discountAmount, computed by
  /// services/shopPricing.service.js and never by the app.
  totalAmount     Decimal     @db.Decimal(12, 2)
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  couponCode      String?
  /// Frozen copy of the quote the order was placed on (per-shipment breakdown,
  /// tax lines, the settings values in force). An invoice reprinted a year later
  /// has to show what was actually charged, not what today's settings would say.
  pricingSnapshot Json?
  deliveryAddress Json
  /// Serviceability decision recorded at checkout: the PIN code and the ETA the
  /// buyer was shown. Kept so a delivery dispute has a record of the promise.
  deliveryPincode String?
  promisedEtaDays Int?
  paymentMethod   String      @default("cod")
  paymentStatus   String      @default("pending")
  notes           String?
  /// Razorpay payment id, as a UNIQUE column. It used to live only inside the
  /// free-text `notes` ("razorpay:<id>") with no constraint, so replaying the same
  /// signed (orderId, paymentId, signature) triple after re-filling the cart
  /// created a SECOND fully-paid order. The unique index makes the replay fail at
  /// the DB instead of relying on the handler noticing.
  paymentRef      String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  user            User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  // Order history: where userId + ORDER BY createdAt DESC (paginated).
  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  sellerId   String?
  /// WHICH OFFER was purchased. Without this, purchased-offer history is
  /// unreconstructable after the split (productId alone cannot say which of three
  /// Kendras sold it), so it is added BEFORE the backfill, not after.
  /// Scalar-only — no relation field — so deleting a listing never cascades into
  /// order history.
  listingId  String?
  /// Snapshot of the variant sold, for the same reason.
  variantId  String?
  // [FIX #4/#13] Per-item status for multi-seller orders. Each seller controls
  // only their own items' status. The overall Order.status is derived from all items.
  status     String  @default("PENDING")

  // ── Immutable snapshot of what was sold (SHOP-HARDENING) ───────────────────
  // Order history joined to `products` for the name and image, so an admin
  // renaming a catalog row, or a seller's re-upload, silently rewrote what a
  // farmer's two-year-old order says they bought. Everything a past order needs
  // to render is frozen here at creation. Nullable: rows created before this
  // change still fall back to the join.
  productName   String?
  productNameMr String?
  productImage  String?
  brand         String?
  unit          String?
  packSize      String?
  sellerName    String?
  taxRatePct    Decimal?  @db.Decimal(5, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(12, 2)
  /// Which physical batch was shipped, and the label version in force at the
  /// time. A recall is announced by batch, so without this an affected buyer
  /// cannot be identified; and the safety text shown at purchase must stay
  /// reproducible even after the manufacturer publishes a new label.
  batchNumber   String?
  batchExpiry   DateTime?
  labelVersion  String?
  complianceSnapshot Json?
  /// Return eligibility decided by the BACKEND at order time from the product's
  /// category rules, and frozen. Consumable / opened-chemical rules differ from
  /// machinery, and the app must never be the one deciding.
  returnWindowDays Int?
  returnEligible   Boolean @default(true)

  // ── State-transition timestamps (CATALOG-SPLIT) ─────────────────────────────
  // Nothing but createdAt/updatedAt existed before, which made dispatch SLA and
  // cancellation rate literally uncomputable. sellerMetrics.service.js reads these.
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@index([sellerId, orderId])
  @@index([listingId])
  // sellerMetrics scans one seller's terminal items in a rolling window.
  @@index([sellerId, status, createdAt])
  // Verified-purchase check on review submit: WHERE productId = ? AND status = ?.
  // It had no index and fell back to a scan of order_items.
  @@index([productId, status])
  // Recall fan-out: "who bought batch X of product Y". Without it a recall is a
  // full scan of every order item ever placed.
  @@index([batchNumber])
  @@map("order_items")
}

// ── Returns / RMA (admin SUPPORT) ─────────────────────────────────────────────
// One buyer-initiated return/refund request against an order (optionally a single
// item). Scalar orderId/userId FKs only — no relation fields on Order/User — so
// this is purely additive. The admin Returns queue (SUPPORT scope) approves /
// rejects / refunds; a REFUNDED resolution flips the linked Order atomically.
model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  orderItemId  String?
  userId       String
  /// Which seller the return is against. There was no seller reference at all, so
  /// SellerProfile.returnRate had nothing to aggregate over.
  sellerId     String?
  reason       String
  status       ReturnStatus @default(REQUESTED)
  refundAmount Decimal?     @db.Decimal(12, 2)
  resolvedBy   String? // admin userId who approved/rejected/refunded
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([userId])
  @@index([sellerId])
  @@index([createdAt])
  @@map("return_requests")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String?
  /// WHO is being rated. Without it a review can never be attributed to a seller,
  /// so seller rating (buy-box weight w2) has no source data at all.
  sellerId  String?
  /// WHAT was bought. Makes the review verifiable as a real purchase AND is the
  /// new uniqueness axis: `@@unique([userId, productId])` used to mean a buyer who
  /// bought the same seed from two Kendras could only rate one of them.
  /// Scalar-only (no relation field) so review history survives order-item churn.
  orderItemId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, orderItemId])
  @@index([productId])
  @@index([sellerId])
  // Buyer review history: WHERE userId = ?. A dedicated single-column index for
  // the by-user lookup (previously covered by the [userId, productId] unique).
  @@index([userId])
  @@map("reviews")
}

model AnimalListing {
  id             String        @id @default(uuid())
  sellerId       String
  animal         String
  breed          String
  age            String
  gender         AnimalGender
  weight         String
  price          Decimal       @db.Decimal(12, 2)
  milkYield      String?
  description    String?
  images         String[]
  tags           String[]
  verified       Boolean       @default(false)
  status         ListingStatus @default(ACTIVE)
  sellerLocation String
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lat            Float?
  lng            Float?

  // ── Normalised numerics (derived from the display strings on every write) ──
  // age/weight/milkYield above stay exactly as the seller typed them because
  // that is what the UI renders. These are the machine-readable twins that the
  // indexed range filters and sorts actually use. Nullable: an unparseable
  // string yields null rather than failing the write, and legacy rows are
  // filled in by prisma/backfill-animals.js.
  ageMonths      Int?
  weightKg       Float?
  milkYieldLpd   Float?

  // ── Structured flags (previously encoded only as free-text `tags`) ─────────
  // `tags` keeps being written for backward compatibility; these are what the
  // filters query, because a String[] contains-scan cannot use an index.
  negotiable        Boolean @default(false)
  vaccinated        Boolean @default(false)
  healthCertificate Boolean @default(false)
  // Only meaningful for female milch animals; null = not stated.
  pregnant          Boolean?
  lactating         Boolean?

  // Lowercased haystack: animal + breed + location + tags + description head,
  // PLUS the Marathi/Hindi names of the animal, so "म्हैस" finds a listing
  // typed as "Buffalo". One trigram index instead of OR-ing four columns.
  searchText     String?

  // ── Lifecycle ─────────────────────────────────────────────────────────────
  // Livestock sells fast; a listing left up for months is the main source of
  // "seller doesn't reply" complaints. expiresAt is set on create/renew and
  // swept by the expiry job; renewing pushes it out and stamps lastRenewedAt.
  expiresAt      DateTime?
  lastRenewedAt  DateTime?

  seller         User          @relation(fields: [sellerId], references: [id])
  chats          Chat[]
  reports        ListingReport[]

  @@index([sellerId])
  @@index([animal])
  @@index([status])
  @@index([createdAt])
  // Seller's listings: where sellerId (+ status inequality) + ORDER BY createdAt DESC.
  @@index([sellerId, createdAt(sort: Desc)])
  // The marketplace default: WHERE status='ACTIVE' ORDER BY createdAt DESC.
  // Without the composite, Postgres bitmap-scanned @@index([status]) and then
  // sorted the whole ACTIVE set on every page.
  @@index([status, createdAt(sort: Desc)])
  // Category browse (the animal-type pills) with the same ordering.
  @@index([status, animal, createdAt(sort: Desc)])
  // Price sort / price-range filter over ACTIVE rows.
  @@index([status, price])
  // Expiry sweep: WHERE status='ACTIVE' AND expiresAt < now().
  @@index([status, expiresAt])
  // Bounding-box prefilter for the radius search (geoPageIds).
  @@index([lat, lng])
  // Trigram GIN — accelerates search OR (animal/breed/sellerLocation ILIKE).
  // All three OR'd columns are indexed so the planner can BitmapOr them.
  @@index([animal(ops: raw("gin_trgm_ops"))], type: Gin, map: "animal_listings_animal_trgm")
  @@index([breed(ops: raw("gin_trgm_ops"))], type: Gin, map: "animal_listings_breed_trgm")
  @@index([sellerLocation(ops: raw("gin_trgm_ops"))], type: Gin, map: "animal_listings_sellerLocation_trgm")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "animal_listings_searchtext_trgm")
  @@map("animal_listings")
}

/// A buyer's report of a problem listing (fraud, wrong animal, already sold,
/// abusive seller). One row per (listing, reporter) so tapping Report twice
/// does not inflate the count; the admin queue reads `status`.
model ListingReport {
  id         String           @id @default(uuid())
  listingId  String
  reporterId String
  reason     String
  details    String?
  status     ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  listing  AnimalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User          @relation("ListingReportsFiled", fields: [reporterId], references: [id])

  @@unique([listingId, reporterId])
  @@index([status, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("listing_reports")
}

/// "Block seller" — a one-way mute. Blocked users' listings are hidden from the
/// blocker's marketplace feed and neither side can open a new chat. Enforced on
/// the SERVER on every read/write, never by the client hiding rows.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Chat {
  id        String        @id @default(uuid())
  listingId String
  sellerId  String
  buyerId   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  buyer     User          @relation("BuyerChats", fields: [buyerId], references: [id])
  listing   AnimalListing @relation(fields: [listingId], references: [id])
  seller    User          @relation("SellerChats", fields: [sellerId], references: [id])

  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@index([buyerId])
  @@map("chats")
}

model ChatMessage {
  id        String    @id @default(uuid())
  chatId    String
  senderId  String
  text      String?
  imageUrl  String?
  readAt    DateTime?
  // Client-generated id for the send attempt. A farmer on a flaky 2G link
  // retries (or the app replays the request after a token refresh) and the same
  // message would land twice. The unique constraint below makes the insert
  // idempotent: the retry hits the conflict and we return the original row.
  // Nullable so pre-existing rows and the legacy socket path still work.
  clientMsgId String?
  createdAt DateTime  @default(now())
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, clientMsgId])
  @@index([chatId])
  @@index([chatId, createdAt])
  // Newest-first history paging: WHERE chatId=? ORDER BY createdAt DESC, id DESC.
  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("chat_messages")
}

model MachineryListing {
  id            String        @id @default(uuid())
  ownerId       String
  name          String
  category      String
  description   String?
  pricePerDay   Decimal       @db.Decimal(12, 2)
  pricePerHour  Decimal?      @db.Decimal(12, 2)
  images        String[]
  location      String
  district      String
  state         String
  available     Boolean       @default(true)
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ageYears      Float?
  availableFrom DateTime?
  availableTo   DateTime?
  brand         String?
  features      String[]
  fuelType      String?
  horsePower    String?
  lat           Float?
  lng           Float?
  mileageHours  Int?
  ownerName     String?
  ownerPhone    String?
  pricePerAcre  Decimal?      @db.Decimal(12, 2)
  rating        Float         @default(0)
  ratingCount   Int           @default(0)
  videos        String[]
  bookings      Booking[]
  owner         User          @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([category])
  @@index([district])
  @@index([status])
  @@index([status, category])
  @@index([lat, lng])
  // Trigram GIN — search OR (name/brand/description/location ILIKE).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "machinery_listings_name_trgm")
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin, map: "machinery_listings_brand_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "machinery_listings_description_trgm")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "machinery_listings_location_trgm")
  @@map("machinery_listings")
}

model LabourListing {
  id            String        @id @default(uuid())
  providerId    String
  name          String
  skills        String[]
  pricePerDay   Decimal       @db.Decimal(12, 2)
  groupSize     Int           @default(1)
  experience    String?
  languages     String[]
  location      String
  district      String
  state         String
  available     Boolean       @default(true)
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  availableFrom DateTime?
  availableTo   DateTime?
  description   String?
  groupName     String?
  image         String?
  images        String[]
  lat           Float?
  leader        String?
  lng           Float?
  phone         String?
  pricePerHour  Decimal?      @db.Decimal(12, 2)
  rating        Float         @default(0)
  ratingCount   Int           @default(0)
  videos        String[]
  bookings      Booking[]
  provider      User          @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([district])
  @@index([status])
  @@index([lat, lng])
  // Trigram GIN — search OR (name/leader/description/location ILIKE).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "labour_listings_name_trgm")
  @@index([leader(ops: raw("gin_trgm_ops"))], type: Gin, map: "labour_listings_leader_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "labour_listings_description_trgm")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "labour_listings_location_trgm")
  @@map("labour_listings")
}

model Booking {
  id                 String            @id @default(uuid())
  userId             String
  machineryListingId String?
  labourListingId    String?
  startDate          DateTime
  endDate            DateTime
  days               Int
  totalAmount        Decimal           @db.Decimal(12, 2)
  status             BookingStatus     @default(PENDING)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  hours              Int?
  workerCount        Int?              @default(1)
  labourListing      LabourListing?    @relation(fields: [labourListingId], references: [id])
  machineryListing   MachineryListing? @relation(fields: [machineryListingId], references: [id])
  user               User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([machineryListingId])
  @@index([labourListingId])
  @@index([startDate, endDate])
  @@index([createdAt])
  // My-bookings (no status filter): where userId + ORDER BY createdAt DESC.
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookings")
}

model Post {
  id           String         @id @default(uuid())
  authorId     String
  category     String
  title        String
  description  String
  images       String[]
  tags         String[]
  likeCount    Int            @default(0)
  commentCount Int            @default(0)
  viewCount    Int            @default(0)
  isPinned     Boolean        @default(false)
  scope        PostScope      @default(ALL)
  district     String?
  city         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime? // soft-delete tombstone — non-null rows are hidden from all reads
  comments     Comment[]
  bookmarks    PostBookmark[]
  likes        PostLike[]
  author       User           @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([category])
  @@index([district])
  @@index([scope, district])
  @@index([createdAt])
  @@index([deletedAt])
  // The feed: WHERE "deletedAt" IS NULL ORDER BY "isPinned" DESC, "createdAt" DESC.
  // Without it Postgres seq-scans every post and top-N sorts the whole live set
  // for each page. Measured at 80k posts: 13.1 ms / 8,001 buffers -> 0.14 ms /
  // 344, and the sort disappears entirely.
  //
  // NOT partial. `WHERE "deletedAt" IS NULL` would be faster still (0.02 ms, 27
  // buffers) but Prisma cannot express a partial index, so it would live only in
  // manual SQL and `prisma db push` would silently drop it. Surviving db push is
  // worth more than the last tenth of a millisecond.
  @@index([isPinned(sort: Desc), createdAt(sort: Desc)])
  // Trigram GIN — community search OR (title/description ILIKE).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_title_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_description_trgm")
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostBookmark {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_bookmarks")
}

model Comment {
  id        String        @id @default(uuid())
  postId    String
  authorId  String
  parentId  String?
  text      String
  likeCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  likes     CommentLike[]
  author    User          @relation(fields: [authorId], references: [id])
  parent    Comment?      @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("Replies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([postId, createdAt])
  @@index([authorId])
  // Threaded replies. Prisma's nested `replies` include emits
  // WHERE "parentId" IN (…) ORDER BY "createdAt" ASC, and there was no parentId
  // index at all — so opening one post's comments sequentially scanned the whole
  // comments table, for every post, on every open. Measured at 100k rows:
  // Seq Scan 8.3 ms / 5,109 buffers -> Bitmap Index Scan 0.79 ms / 346.
  @@index([parentId, createdAt])
  @@map("comments")
}

model CommentLike {
  id        String  @id @default(uuid())
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model Group {
  id            String         @id @default(uuid())
  name          String
  description   String?
  avatar        String?
  createdById   String
  district      String?
  city          String?
  isPublic      Boolean        @default(true)
  memberCount   Int            @default(1)
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  members       GroupMember[]
  messages      GroupMessage[]
  createdBy     User           @relation("GroupsCreated", fields: [createdById], references: [id])

  @@index([district])
  @@index([createdById])
  // Trigram GIN — group discovery search (name ILIKE '%term%').
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "groups_name_trgm")
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  senderId  String
  text      String?
  imageUrl  String?
  type      String   @default("text")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation("GroupMessagesSent", fields: [senderId], references: [id])

  @@index([groupId])
  @@index([groupId, createdAt])
  @@index([senderId])
  @@map("group_messages")
}

model DirectMessage {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  text       String?
  imageUrl   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  receiver   User      @relation("DMsReceived", fields: [receiverId], references: [id])
  sender     User      @relation("DMsSent", fields: [senderId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([receiverId, readAt])
  @@map("direct_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model CropDiseaseReport {
  id              String            @id @default(uuid())
  userId          String
  pincode         String
  cropType        String
  growthStage     String
  variety         String?
  fieldArea       String?
  symptoms        String[]
  imageCount      Int               @default(0)
  // Cloudinary secure URLs for the photos that powered the diagnosis.
  // Populated during /scan/submit; lets PastReportScreen render the
  // actual scanned images instead of the disease name in text form only.
  imageUrls       String[]          @default([])
